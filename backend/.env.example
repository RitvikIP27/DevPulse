# --- Database ---
DATABASE_URL="""

# --- GitHub ---
# Personal Access Token (classic) with repo + workflow scope, or a GitHub App token.
GITHUB_TOKEN=""
# Comma-separated list of "owner/repo" to track
GITHUB_REPOS=""
# Secret used to verify GitHub webhook signatures
GITHUB_WEBHOOK_SECRET=change_me

# --- App ---
ENVIRONMENT=development

# --- Runtime / incident providers (optional) ---
# Unset means NOT_CONFIGURED. DevPulse never substitutes a default endpoint.
PROMETHEUS_URL=""
PAGERDUTY_TOKEN=""
PAGERDUTY_SERVICE_IDS=""

# --- Demo ---
# Enables the synthetic reference scenarios seeded by `python -m app.demo_seed`.
DEMO_MODE=false

# --- AI reasoning (optional) ---
# Without a key the deterministic evidence package is still produced and shown;
# only the narrative analysis is unavailable.
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-opus-5"

# --- Authentication ---
# Off by default so a local install is not forced through a login.
# MUST be true before exposing DevPulse beyond localhost.
AUTH_ENABLED=false
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY="change-me"
ACCESS_TOKEN_EXPIRE_MINUTES=720
# Narrow this whenever auth is enabled.
CORS_ORIGINS="*"
